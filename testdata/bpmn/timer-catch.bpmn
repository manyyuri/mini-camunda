<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://mini-camunda.test">
  <process id="timercatch-demo" name="定时捕获" isExecutable="true">
    <startEvent id="start"/>
    <intermediateCatchEvent id="wait_timer" name="等待1.5秒">
      <timerEventDefinition>
        <timeDuration>PT1.5S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="wait_timer"/>
    <sequenceFlow id="f2" sourceRef="wait_timer" targetRef="end"/>
  </process>
</definitions>
