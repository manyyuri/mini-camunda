<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://mini-camunda.test">
  <process id="excl-demo" name="排他网关" isExecutable="true">
    <startEvent id="start"/>
    <exclusiveGateway id="gw" name="按分数" default="f_low"/>
    <serviceTask id="st_high" name="高分" camunda:class="noop"/>
    <serviceTask id="st_low" name="低分" camunda:class="noop"/>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="gw"/>
    <sequenceFlow id="f_high" name="score>=60" sourceRef="gw" targetRef="st_high">
      <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${score >= 60}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_low" name="默认" sourceRef="gw" targetRef="st_low"/>
    <sequenceFlow id="f2" sourceRef="st_high" targetRef="end"/>
    <sequenceFlow id="f3" sourceRef="st_low" targetRef="end"/>
  </process>
</definitions>
